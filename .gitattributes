# 统一行尾为 LF，防止 Windows 检出/构建时 CRLF 与仓库产物不一致
* text=auto eol=lf

*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md    text eol=lf
*.toml text eol=lf

# 二进制资源不做行尾/文本处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf binary
